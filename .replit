run = "gunicorn app:app --bind 0.0.0.0:5000"
modules = ["python-3.11"]

[deployment]
run = "gunicorn app:app --bind 0.0.0.0:5000"
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[nix]

[agent]
expertMode = true
